{
  "name": "evolution-sieve-filters",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",

  // Sets up the Meson build as soon as the container is created: generates
  // build/compile_commands.json, which clangd uses for IntelliSense.
  // The chown of /workspaces (root by default) lets dpkg-buildpackage
  // (scripts/build-deb.sh) drop the .deb/.changes/.buildinfo there, as
  // the Debian convention requires (artifacts in the repo's parent directory).
  "postCreateCommand": "sudo chown vscode:vscode /workspaces; meson setup build --wipe || meson setup build",

  "mounts": [
    "source=${env:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "mesonbuild.mesonbuild",
        "ms-vscode.cpptools",
        "anthropic.claude-code"
      ],
      "settings": {
        // clangd for analysis, cpptools only for GDB debugging.
        "C_Cpp.intelliSenseEngine": "disabled",
        "clangd.arguments": [
          "--background-index",
          "--compile-commands-dir=build",
          "--header-insertion=never"
        ],
        "mesonbuild.configureOnOpen": true,
        "mesonbuild.buildFolder": "build",
        "files.associations": {
          "*.h": "c"
        }
      }
    }
  }
}
