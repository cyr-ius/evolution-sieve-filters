# Gabarit consommé par tests/dovecot/run.sh — NE PAS lancer Dovecot dessus
# directement. Les jetons @...@ sont remplacés par run.sh (chemin absolu de la
# fixture, uid/gid de l'utilisateur courant).
#
# ⚠ SYNTAXE DOVECOT 2.3. Depuis le passage du devcontainer à Debian trixie,
# Dovecot est en 2.4 : ce gabarit doit être porté (blocs `passdb`/`userdb`
# nommés, `mail_driver`/`mail_path`, `ssl_server_cert_file`, disparition du
# bloc `plugin {}` au profit de `sieve { }`, `auth_allow_cleartext`…). À faire
# et vérifier contre le vrai Dovecot 2.4 après reconstruction du conteneur —
# voir tests/dovecot/README.md.
#
# Instance Dovecot + Pigeonhole minimale et jetable, dédiée aux tests du
# client ManageSieve : aucun compte système, tout sous tests/dovecot/.

# base_dir doit être un répertoire distinct de l'emplacement de CE fichier :
# Dovecot recopie sa conf dans base_dir/dovecot.conf, ce qui créerait un
# lien symbolique récursif si les deux chemins coïncidaient.
base_dir      = @FIXTURE_DIR@/run/state
log_path      = @FIXTURE_DIR@/run/dovecot.log
info_log_path = @FIXTURE_DIR@/run/dovecot.log

# Seul ManageSieve nous intéresse ; pas d'IMAP/POP3/LMTP.
protocols = sieve

# ssl = required : l'authentification en clair est refusée tant que la session
# n'est pas chiffrée (STARTTLS ou TLS implicite). Les deux chemins sont exposés,
# sur deux ports distincts (voir service managesieve-login plus bas).
ssl              = required
ssl_cert         = <@FIXTURE_DIR@/run/cert.pem
ssl_key          = <@FIXTURE_DIR@/run/key.pem
ssl_dh           = </usr/share/dovecot/dh.pem
ssl_min_protocol = TLSv1.2

disable_plaintext_auth = no
# Jeu de mécanismes réaliste pour exercer la couche SASL du client : PLAIN et
# LOGIN (mot de passe transmis), CRAM-MD5 et SCRAM-SHA-1/256 (défi-réponse,
# le secret ne transite pas). La passdb ci-dessous stocke le mot de passe en
# clair ({PLAIN}), ce qui permet à Dovecot de dériver tous ces mécanismes.
auth_mechanisms        = plain login cram-md5 scram-sha-1 scram-sha-256
auth_verbose           = yes

# Base d'utilisateurs statique (fichier passwd-file) : « testuser / testpass ».
passdb {
  driver = passwd-file
  args   = @FIXTURE_DIR@/run/users
}
userdb {
  driver = passwd-file
  args   = @FIXTURE_DIR@/run/users
  default_fields = uid=@UID@ gid=@GID@ home=@FIXTURE_DIR@/mail/%u
}

mail_location = maildir:@FIXTURE_DIR@/mail/%u/Maildir

service managesieve-login {
  # 4190 : STARTTLS — comportement d'un vrai serveur ManageSieve (RFC 5804).
  inet_listener sieve {
    port = 4190
  }
  # 4191 : TLS implicite — mode par défaut de sieve-managesieve-client
  #        (sieve_managesieve_client_new(..., implicit_tls = TRUE)).
  inet_listener sieve_implicit_tls {
    port = 4191
    ssl  = yes
  }
}

plugin {
  sieve = file:@FIXTURE_DIR@/mail/%u/sieve;active=@FIXTURE_DIR@/mail/%u/.dovecot.sieve
}
