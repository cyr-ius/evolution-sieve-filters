# Template consumed by tests/dovecot/run.sh — DO NOT run Dovecot directly on
# this file. The @...@ tokens are substituted by run.sh (fixture's absolute
# path, current user's uid/gid).
#
# DOVECOT 2.4 SYNTAX (ported from the original 2.3 template when the
# devcontainer moved to Debian trixie): named `passdb`/`userdb` blocks
# (`passdb passwd-file { }` instead of `passdb { driver = passwd-file }`),
# `passwd_file_path` instead of `args`, `mail_driver`/`mail_path` instead of
# `mail_location`, `ssl_server_cert_file`/`ssl_server_key_file` instead of
# `ssl_cert`/`ssl_key` (no `ssl_dh` — DH params are deprecated/optional in
# 2.4), `auth_allow_cleartext` instead of `disable_plaintext_auth`. The
# `plugin { sieve = ... }` block is unchanged. Verified against the real
# Dovecot 2.4 (see tests/dovecot/README.md).
#
# Minimal, disposable Dovecot + Pigeonhole instance dedicated to the
# ManageSieve client tests: no system account, everything under tests/dovecot/.

dovecot_config_version  = 2.4.0
dovecot_storage_version = 2.4.0

# base_dir must be a directory distinct from where THIS file lives:
# Dovecot copies its config into base_dir/dovecot.conf, which would create a
# recursive symlink loop if the two paths coincided.
base_dir      = @FIXTURE_DIR@/run/state
log_path      = @FIXTURE_DIR@/run/dovecot.log
info_log_path = @FIXTURE_DIR@/run/dovecot.log

# Only ManageSieve matters here; no IMAP/POP3/LMTP.
protocols = sieve

# ssl = required: plaintext auth is refused as long as the session isn't
# encrypted (STARTTLS or implicit TLS). Both paths are exposed,
# on two distinct ports (see the managesieve-login service below).
ssl                   = required
ssl_server_cert_file  = @FIXTURE_DIR@/run/cert.pem
ssl_server_key_file   = @FIXTURE_DIR@/run/key.pem
ssl_min_protocol      = TLSv1.2

# auth_allow_cleartext left at its default (no): irrelevant here anyway,
# since ssl = required already forces TLS before any auth happens.
# A realistic set of mechanisms to exercise the client's SASL layer: PLAIN and
# LOGIN (password sent as-is), CRAM-MD5 and SCRAM-SHA-1/256 (challenge-response,
# the secret never travels). The passdb below stores the password in
# cleartext ({PLAIN}), which lets Dovecot derive all these mechanisms.
# gssapi needs the "dovecot-gssapi" package (a separate plugin, NOT part
# of dovecot-core despite what its own error-message strings might
# suggest) and a keytab (see kdc.sh, which creates one against a
# disposable local KDC). @GSSAPI_MECH@ is substituted by run.sh: "gssapi"
# if the plugin .so is actually installed, empty otherwise — listing
# "gssapi" here unconditionally would make auth_mechanisms reference an
# unknown mechanism, which is FATAL for the whole auth process (crashing
# PLAIN/LOGIN/etc too, not just GSSAPI) when the plugin is missing.
# auth_username_format strips the "@REALM" suffix Dovecot's GSSAPI
# mechanism appends to the authenticated principal, so it matches the
# plain "testuser" this fixture's passdb/userdb expect.
auth_mechanisms        = plain login cram-md5 scram-sha-1 scram-sha-256@GSSAPI_MECH@
auth_gssapi_hostname   = localhost
auth_krb5_keytab       = @FIXTURE_DIR@/run/krb5/dovecot.keytab
auth_username_format   = %{user|username|lower}
auth_verbose           = yes

# Static user base (passwd-file): "testuser / testpass". The file already
# carries uid/gid/home (classic passwd(5) columns), so no extra
# userdb_fields override is needed.
passdb passwd-file {
  passwd_file_path = @FIXTURE_DIR@/run/users
}
userdb passwd-file {
  passwd_file_path = @FIXTURE_DIR@/run/users
}

mail_driver = maildir
mail_path   = @FIXTURE_DIR@/mail/%{user}/Maildir

service managesieve-login {
  # 4190: STARTTLS — behavior of a real ManageSieve server (RFC 5804).
  inet_listener sieve {
    port = 4190
  }
  # 4191: implicit TLS — default mode of sieve-managesieve-client
  #       (sieve_managesieve_client_new(..., implicit_tls = TRUE)).
  inet_listener sieve_implicit_tls {
    port = 4191
    ssl  = yes
  }
}

sieve_script_path        = @FIXTURE_DIR@/mail/%{user}/sieve
sieve_script_active_path = @FIXTURE_DIR@/mail/%{user}/.dovecot.sieve
